{
  "schema": "ais-conformance/0.0.2",
  "profile": "core",
  "cases": [
    {
      "id": "safe-auto-execute-low-risk",
      "kind": "pack_approvals_decision",
      "input": {
        "approvals": {
          "mode": "safe",
          "auto_execute_max_risk_level": 2,
          "require_approval_min_risk_level": 4
        },
        "risk_level": 2
      },
      "expect": { "needs_confirmation": false, "confirmer": "none" }
    },
    {
      "id": "safe-gap-is-conservative",
      "kind": "pack_approvals_decision",
      "input": {
        "approvals": {
          "mode": "safe",
          "auto_execute_max_risk_level": 2,
          "require_approval_min_risk_level": 4
        },
        "risk_level": 3
      },
      "expect": { "needs_confirmation": true, "confirmer": "human" }
    },
    {
      "id": "assist-llm-may-approve",
      "kind": "pack_approvals_decision",
      "input": {
        "approvals": {
          "mode": "assist",
          "auto_execute_max_risk_level": 2,
          "require_approval_min_risk_level": 3,
          "llm_may_approve_max_risk_level": 3
        },
        "risk_level": 3
      },
      "expect": { "needs_confirmation": true, "confirmer": "llm" }
    },
    {
      "id": "assist-high-risk-still-human",
      "kind": "pack_approvals_decision",
      "input": {
        "approvals": {
          "mode": "assist",
          "auto_execute_max_risk_level": 2,
          "require_approval_min_risk_level": 3,
          "llm_may_approve_max_risk_level": 3
        },
        "risk_level": 5
      },
      "expect": { "needs_confirmation": true, "confirmer": "human" }
    },
    {
      "id": "yolo-always-auto-approve-when-confirm-needed",
      "kind": "pack_approvals_decision",
      "input": {
        "approvals": {
          "mode": "yolo",
          "auto_execute_max_risk_level": 1,
          "require_approval_min_risk_level": 2
        },
        "risk_level": 5
      },
      "expect": { "needs_confirmation": true, "confirmer": "auto" }
    }
  ]
}
