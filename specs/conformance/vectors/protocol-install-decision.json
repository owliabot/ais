{
  "schema": "ais-conformance/0.0.2",
  "profile": "core",
  "cases": [
    {
      "id": "safe-rejects-remote-url-by-default",
      "kind": "protocol_install_decision",
      "input": {
        "mode": "safe",
        "source_kind": "remote_url",
        "allowed_sources": ["local_path", "registry_ref"]
      },
      "expect": {
        "decision": "reject",
        "reason_code": "source_kind_not_allowed"
      }
    },
    {
      "id": "assist-registry-ref-needs-confirm",
      "kind": "protocol_install_decision",
      "input": {
        "mode": "assist",
        "source_kind": "registry_ref",
        "allowed_sources": ["registry_ref"]
      },
      "expect": {
        "decision": "need_user_confirm",
        "reason_code": "assist_dynamic_source_requires_confirm"
      }
    },
    {
      "id": "assist-llm-generated-needs-confirm",
      "kind": "protocol_install_decision",
      "input": {
        "mode": "assist",
        "source_kind": "llm_generated",
        "allowed_sources": ["llm_generated"]
      },
      "expect": {
        "decision": "need_user_confirm",
        "reason_code": "assist_dynamic_source_requires_confirm"
      }
    },
    {
      "id": "yolo-remote-allowed-when-source-allowed",
      "kind": "protocol_install_decision",
      "input": {
        "mode": "yolo",
        "source_kind": "remote_url",
        "allowed_sources": ["remote_url"]
      },
      "expect": {
        "decision": "allow"
      }
    },
    {
      "id": "yolo-signature-required-rejects-unsigned",
      "kind": "protocol_install_decision",
      "input": {
        "mode": "yolo",
        "source_kind": "registry_ref",
        "allowed_sources": ["registry_ref"],
        "require_signature": true,
        "has_signature": false
      },
      "expect": {
        "decision": "reject",
        "reason_code": "signature_required"
      }
    }
  ]
}
