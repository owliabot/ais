{
  "schema": "ais-conformance/0.0.2",
  "profile": "core",
  "cases": [
    {
      "id": "plugin-unregistered-must-reject-even-if-pack-allows",
      "kind": "execution_handler_registration_decision",
      "input": {
        "execution_type": "offchain_apy_query",
        "core_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction"],
        "registered_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction"],
        "pack_plugin_allowlist": {
          "active": true,
          "enabled_types": ["offchain_apy_query"]
        }
      },
      "expect": {
        "decision": "reject",
        "reason_code": "unregistered_execution_handler"
      }
    },
    {
      "id": "plugin-registered-but-pack-disallows-must-reject",
      "kind": "execution_handler_registration_decision",
      "input": {
        "execution_type": "offchain_apy_query",
        "core_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction"],
        "registered_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction", "offchain_apy_query"],
        "pack_plugin_allowlist": {
          "active": true,
          "enabled_types": ["sui_tx"]
        }
      },
      "expect": {
        "decision": "reject",
        "reason_code": "plugin_execution_type_not_allowlisted"
      }
    },
    {
      "id": "plugin-registered-and-pack-allows-can-execute",
      "kind": "execution_handler_registration_decision",
      "input": {
        "execution_type": "offchain_apy_query",
        "core_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction"],
        "registered_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction", "offchain_apy_query"],
        "pack_plugin_allowlist": {
          "active": true,
          "enabled_types": ["offchain_apy_query"]
        }
      },
      "expect": {
        "decision": "allow"
      }
    },
    {
      "id": "core-type-without-handler-must-reject",
      "kind": "execution_handler_registration_decision",
      "input": {
        "execution_type": "evm_call",
        "core_execution_types": ["evm_read", "evm_call", "solana_read", "solana_instruction"],
        "registered_execution_types": ["evm_read", "solana_read", "solana_instruction"]
      },
      "expect": {
        "decision": "reject",
        "reason_code": "unregistered_execution_handler"
      }
    }
  ]
