{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ais:0.0.2:engine-command",
  "title": "AIS Engine Command JSONL Envelope (ais-engine-command/0.0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command"],
  "properties": {
    "schema": { "const": "ais-engine-command/0.0.1" },
    "command": { "$ref": "#/$defs/command" }
  },
  "$defs": {
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "runtimePatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "value"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["set", "merge"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "commandType": {
      "type": "string",
      "enum": [
        "apply_patches",
        "user_confirm",
        "user_input",
        "user_select",
        "cancel",
        "replace_plan"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/commandType" },
        "data": {
          "type": "object",
          "additionalProperties": true,
          "default": {}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "apply_patches" } },
            "required": ["type"]
          },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["patches"],
                "properties": {
                  "patches": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/runtimePatch" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "user_confirm" } },
            "required": ["type"]
          },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "decision"],
                "properties": {
                  "node_id": { "type": "string", "minLength": 1 },
                  "decision": { "type": "string", "enum": ["approve", "deny"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "user_input" } },
            "required": ["type"]
          },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_id", "value"],
                "properties": {
                  "input_id": { "type": "string", "minLength": 1 },
                  "value": {},
                  "target_path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^inputs\\."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "user_select" } },
            "required": ["type"]
          },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["input_id"],
                "properties": {
                  "input_id": { "type": "string", "minLength": 1 },
                  "selected_value": {},
                  "selected_index": { "type": "integer", "minimum": 1 },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "oneOf": [
                        { "type": "string", "minLength": 1 },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["label"],
                          "properties": {
                            "label": { "type": "string", "minLength": 1 },
                            "value": {}
                          }
                        }
                      ]
                    }
                  },
                  "target_path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^inputs\\."
                  }
                },
                "anyOf": [
                  { "required": ["selected_value"] },
                  { "required": ["selected_index", "options"] }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "cancel" } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "replace_plan" } },
            "required": ["type"]
          },
          "then": {
            "required": ["data"],
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": ["plan"],
                "properties": {
                  "plan": {
                    "type": "object",
                    "required": ["schema", "nodes"],
                    "properties": {
                      "schema": { "const": "ais-plan/0.0.3" },
                      "nodes": { "type": "array" }
                    },
                    "additionalProperties": true
                  },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
