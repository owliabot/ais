{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais-spec.dev/schemas/0.0.2/agent-checkpoint.schema.json",
  "title": "AIS Agent Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "session_id",
    "checkpoint_seq",
    "saved_at",
    "plan_epoch",
    "active_plan_hash",
    "plan_hash_history",
    "pack_snapshot_hash",
    "catalog_hash",
    "cursor",
    "completed_node_ids",
    "approvals_ledger",
    "side_effects"
  ],
  "properties": {
    "schema": {
      "const": "ais-agent-checkpoint/0.1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_seq": {
      "type": "integer",
      "minimum": 0
    },
    "saved_at": {
      "type": "string",
      "minLength": 1
    },
    "plan_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "active_plan_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "plan_hash_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "pack_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "catalog_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cursor": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object"
    },
    "paused_reason": {
      "type": "string"
    },
    "completed_node_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvals_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/approval_entry"
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/side_effect_entry"
      }
    },
    "plan_snapshot": {
      "type": "object"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "approval_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_hash",
        "node_id",
        "decision",
        "recorded_at"
      ],
      "properties": {
        "confirmation_hash": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "deny"
          ]
        },
        "recorded_at": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string"
        }
      }
    },
    "side_effect_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "effect_type",
        "chain",
        "execution_type",
        "idempotency_key",
        "node_id",
        "status",
        "observed_at"
      ],
      "properties": {
        "schema": {
          "const": "ais-side-effect-record/0.1.0"
        },
        "effect_type": {
          "type": "string",
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "chain": {
          "type": "string",
          "minLength": 1
        },
        "execution_type": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "prepared",
            "sent",
            "confirmed",
            "reverted",
            "unknown"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1
        },
        "tx_hash": {
          "type": "string"
        },
        "nonce": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "provider_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason_code": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
