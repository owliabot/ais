{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais-spec.dev/schemas/0.0.2/agent-planning-tools.schema.json",
  "title": "AIS Agent Planning Tools",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "payload"
  ],
  "properties": {
    "schema": {
      "const": "ais-agent-planning-tools/0.1.0"
    },
    "tool": {
      "type": "string",
      "enum": [
        "plan.begin",
        "plan.propose_todos",
        "plan.check_segment",
        "plan.propose_segment",
        "plan.revise_segment"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "plan.begin"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/begin_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "plan.propose_todos"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/todos_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "plan.check_segment"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/check_segment_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "plan.propose_segment"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/segment_payload"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "plan.revise_segment"
          }
        },
        "required": [
          "tool"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/revise_payload"
          }
        }
      }
    }
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason_code",
        "message"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "schema_error",
            "compile_error",
            "policy_error",
            "runtime_error"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "suggestion": {
          "type": "string"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code"
      ],
      "properties": {
        "reason_code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "properties": {
            "questions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/missing_input_question"
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "missing_input_option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "value": {},
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "missing_input_question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/missing_input_option"
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "segment_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "candidate_ref",
        "inputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "query",
            "action",
            "assert",
            "branch"
          ]
        },
        "candidate_ref": {
          "type": "string",
          "pattern": ".+@.+/.+"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": true
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stores": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cel"
          ],
          "properties": {
            "cel": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "until": {
          "$ref": "#/$defs/value_ref"
        },
        "retry": {
          "$ref": "#/$defs/retry_policy"
        },
        "timeout_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "constraint_templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_template"
          }
        },
        "reason": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "cursor_in",
        "cursor_out",
        "done",
        "steps"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "cursor_in": {
          "type": "string",
          "minLength": 1
        },
        "cursor_out": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment_step"
          }
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "check_segment_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment"
      ],
      "properties": {
        "segment": {
          "$ref": "#/$defs/segment"
        }
      }
    },
    "constraint_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "value_ref_lit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lit"
      ],
      "properties": {
        "lit": {}
      }
    },
    "value_ref_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value_ref_cel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cel"
      ],
      "properties": {
        "cel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "value_ref_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/value_ref"
          }
        }
      }
    },
    "value_ref_array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "array"
      ],
      "properties": {
        "array": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value_ref"
          }
        }
      }
    },
    "value_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/value_ref_lit"
        },
        {
          "$ref": "#/$defs/value_ref_ref"
        },
        {
          "$ref": "#/$defs/value_ref_cel"
        },
        {
          "$ref": "#/$defs/value_ref_object"
        },
        {
          "$ref": "#/$defs/value_ref_array"
        }
      ]
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_ms"
      ],
      "properties": {
        "interval_ms": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "backoff": {
          "type": "string",
          "enum": [
            "fixed"
          ]
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "begin_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "pack_snapshot_hash",
        "catalog_hash",
        "session_id",
        "snapshot_hash",
        "cursor",
        "limits"
      ],
      "properties": {
        "intent": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "schema",
            "intent"
          ],
          "properties": {
            "schema": {
              "const": "ais-agent-intent/0.0.1"
            },
            "intent": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "pack_snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalog_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "chain_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rounds",
            "max_segments"
          ],
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1
            },
            "max_segments": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "todo_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "produced_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "canonical_context_ref_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state_summary_projection": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "input_registry": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "schema": {
              "type": "string"
            },
            "known_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "canonical_context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chain_refs": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/canonical_context_ref_item"
                  },
                  {
                    "type": "object",
                    "required": [
                      "chain_ref"
                    ],
                    "properties": {
                      "chain_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            },
            "account_refs": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/canonical_context_ref_item"
                  },
                  {
                    "type": "object",
                    "required": [
                      "account_ref"
                    ],
                    "properties": {
                      "account_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "role": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            },
            "asset_refs": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/canonical_context_ref_item"
                  },
                  {
                    "type": "object",
                    "required": [
                      "address"
                    ],
                    "properties": {
                      "address": {
                        "type": "string",
                        "minLength": 1
                      },
                      "chain_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "symbol": {
                        "type": "string",
                        "minLength": 1
                      },
                      "decimals": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                ]
              }
            },
            "amount_refs": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/canonical_context_ref_item"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "amount_ref": {},
                      "amount_human": {},
                      "amount_atomic": {}
                    },
                    "anyOf": [
                      {
                        "required": [
                          "amount_ref"
                        ]
                      },
                      {
                        "required": [
                          "amount_human"
                        ]
                      },
                      {
                        "required": [
                          "amount_atomic"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    "todos_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "snapshot_hash",
        "cursor",
        "status"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "state_summary": {
          "$ref": "#/$defs/state_summary_projection"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "unavailable",
            "invalid"
          ]
        },
        "summary": {
          "type": "string"
        },
        "todos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/todo_item"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "todos"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "invalid"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "segment_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "snapshot_hash",
        "cursor",
        "status",
        "done"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "state_summary": {
          "$ref": "#/$defs/state_summary_projection"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "unavailable",
            "invalid"
          ]
        },
        "cursor_next": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "segment": {
          "$ref": "#/$defs/segment"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "segment",
              "cursor_next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "invalid"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    },
    "revise_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "snapshot_hash",
        "cursor",
        "previous_error",
        "status",
        "done"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "previous_error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "minLength": 1
            },
            "node_id": {
              "type": "string"
            },
            "details": {
              "type": "object"
            },
            "issues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/issue"
              }
            }
          }
        },
        "last_segment": {
          "$ref": "#/$defs/segment"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "unavailable",
            "invalid"
          ]
        },
        "cursor_next": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        },
        "segment": {
          "$ref": "#/$defs/segment"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "proposed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "segment",
              "cursor_next"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "invalid"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          }
        }
      ]
    }
  }
}
