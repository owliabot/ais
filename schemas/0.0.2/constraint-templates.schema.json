{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais-spec.dev/schemas/0.0.2/constraint-templates.schema.json",
  "title": "AIS Constraint Templates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "templates"
  ],
  "properties": {
    "schema": {
      "const": "ais-constraint-templates/0.1.0"
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "effect",
        "expr",
        "param_schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "effect": {
          "type": "string",
          "enum": [
            "hard_block",
            "need_user_confirm"
          ]
        },
        "expr": {
          "type": "string",
          "minLength": 1
        },
        "param_schema": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
