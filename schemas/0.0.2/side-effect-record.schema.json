{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais-spec.dev/schemas/0.0.2/side-effect-record.schema.json",
  "title": "AIS Side Effect Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "effect_type",
    "idempotency_key",
    "node_id",
    "chain",
    "execution_type",
    "status",
    "observed_at"
  ],
  "properties": {
    "schema": {
      "const": "ais-side-effect-record/0.1.0"
    },
    "effect_type": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "chain": {
      "type": "string",
      "minLength": 1
    },
    "execution_type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "prepared",
        "sent",
        "confirmed",
        "reverted",
        "unknown"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1
    },
    "tx_hash": {
      "type": "string"
    },
    "nonce": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "minLength": 1 }
      ]
    },
    "provider_ref": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
