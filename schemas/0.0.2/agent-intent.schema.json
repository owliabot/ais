{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ais-spec.dev/schemas/0.0.2/agent-intent.schema.json",
  "title": "AIS Agent Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent"
  ],
  "properties": {
    "schema": {
      "const": "ais-agent-intent/0.0.1"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "target_chains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "approvals_mode": {
          "type": "string",
          "enum": [
            "safe",
            "assist",
            "yolo"
          ]
        },
        "must_confirm": {
          "type": "boolean"
        },
        "max_planner_rounds": {
          "type": "integer",
          "minimum": 1
        },
        "max_execution_rounds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "context": {
      "type": "object"
    }
  }
}
