{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ais:0.0.2:policy-gate-input",
  "title": "AIS Policy Gate Input (ais-policy-gate-input/0.0.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "chain"],
  "properties": {
    "schema": { "const": "ais-policy-gate-input/0.0.1" },
    "node_id": { "type": "string" },
    "chain": { "type": "string", "minLength": 1 },
    "execution_type": { "type": "string" },
    "action_ref": { "type": "string" },
    "risk_level": { "type": "integer", "minimum": 1, "maximum": 5 },
    "risk_tags": { "type": "array", "items": { "type": "string" } },
    "spend_amount": { "type": "string" },
    "slippage_bps": { "type": "integer", "minimum": 0 },
    "approval_amount": { "type": "string" },
    "unlimited_approval": { "type": "boolean" },
    "spender_address": { "type": "string" },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "unknown_fields": { "type": "array", "items": { "type": "string" } },
    "hard_block_fields": { "type": "array", "items": { "type": "string" } },
    "field_sources": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  }
}

